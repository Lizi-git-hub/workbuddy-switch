{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuddySwitch",
  "version": "20261101.0.0",
  "identifier": "com.trae.workbuddy.switch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Buddy Switch",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["libcrypto-3-x64.dll", "libssl-3-x64.dll"],
    "publisher": "Lizi-git-hub",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMzI1NTZBMjhBOTNCNzAKUldSd082a29hbFV5WCswQW85ZkZ4bU9BS05LaGVmTnZjK0Y5RG9kaDczWHNKcHhKeVhJN0praWwK",
      "endpoints": []
    }
  }
}